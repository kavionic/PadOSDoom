cmake_minimum_required(VERSION 3.25)

include("${OBJECT_LIST}")
file(MAKE_DIRECTORY "${OUTPUT_DIR}")

set(resource_symbols
    malloc=PadOSDoom_Malloc
    calloc=PadOSDoom_Calloc
    realloc=PadOSDoom_Realloc
    free=PadOSDoom_Free
    strdup=PadOSDoom_Strdup
    fopen=PadOSDoom_Fopen
    fclose=PadOSDoom_Fclose
)
set(declarations "")
set(regions "")
set(region_count 0)
set(data_size 0)
set(bss_size 0)
set(section_pattern "^ *([0-9]+) +([^ ]+) +([0-9a-fA-F]+) +[0-9a-fA-F]+ +[0-9a-fA-F]+ +[0-9a-fA-F]+ +2\\*\\*[0-9]+ +(.*)$")

foreach(object IN LISTS DOOM_OBJECT_FILES)
    get_filename_component(object_name "${object}" NAME_WLE)
    string(MAKE_C_IDENTIFIER "${object_name}" object_identifier)
    set(output_object "${OUTPUT_DIR}/${object_name}.o")
    set(response_file "${OUTPUT_DIR}/${object_name}.rsp")
    execute_process(
        COMMAND "${CMAKE_COMMAND}" -E env LC_ALL=C "${OBJDUMP}" -h -w "${object}"
        OUTPUT_VARIABLE section_table
        COMMAND_ERROR_IS_FATAL ANY
    )
    if(section_table MATCHES "\\.gnu\\.lto")
        message(FATAL_ERROR "Doom session reset requires native object sections; disable LTO for the engine.")
    endif()
    set(arguments "")
    foreach(symbol IN LISTS resource_symbols)
        string(APPEND arguments "--redefine-sym=${symbol}\n")
    endforeach()
    string(REPLACE "\r\n" "\n" section_table "${section_table}")
    string(REPLACE "\n" ";" section_lines "${section_table}")
    foreach(line IN LISTS section_lines)
        if(NOT line MATCHES "${section_pattern}")
            continue()
        endif()
        set(section_index "${CMAKE_MATCH_1}")
        set(section_name "${CMAKE_MATCH_2}")
        math(EXPR section_size "0x${CMAKE_MATCH_3}")
        set(section_flags "${CMAKE_MATCH_4}")
        if(section_size EQUAL 0 OR NOT section_flags MATCHES "ALLOC" OR section_flags MATCHES "READONLY")
            continue()
        endif()
        if(section_name MATCHES "^\\.bss($|\\.)")
            set(zero_initialized true)
            math(EXPR bss_size "${bss_size} + ${section_size}")
        elseif(section_name MATCHES "^\\.data($|\\.)")
            set(zero_initialized false)
            math(EXPR data_size "${data_size} + ${section_size}")
        else()
            message(FATAL_ERROR "Unsupported writable Doom section '${section_name}' in '${object}'.")
        endif()
        set(state_symbol "pados_doom_state_${object_identifier}_${section_index}")
        string(APPEND arguments "--add-symbol=${state_symbol}=${section_name}:0,global,object\n")
        string(APPEND declarations "extern unsigned char ${state_symbol}[];\n")
        string(APPEND regions "    { ${state_symbol}, ${section_size}, ${zero_initialized} },\n")
        math(EXPR region_count "${region_count} + 1")
    endforeach()
    # A response file avoids the Windows command-line length limit.
    string(APPEND arguments "\"${object}\"\n\"${output_object}\"\n")
    file(WRITE "${response_file}" "${arguments}")
    execute_process(COMMAND "${OBJCOPY}" "@${response_file}" COMMAND_ERROR_IS_FATAL ANY)
endforeach()

if(region_count EQUAL 0)
    message(FATAL_ERROR "No writable Doom state was found in the engine objects.")
endif()

file(WRITE "${OUTPUT_DIR}/DoomEngineState.cpp"
    "// Generated by CMake/GenerateDoomState.cmake; do not edit.\n\n"
    "#include \"DoomState.h\"\n\n"
    "extern \"C\"\n{\n${declarations}}\n\n"
    "namespace PadOSDoom\n{\n\n"
    "const DoomStateRegion DOOM_STATE_REGIONS[] =\n{\n${regions}};\n\n"
    "const size_t DOOM_STATE_REGION_COUNT = sizeof(DOOM_STATE_REGIONS) / sizeof(DOOM_STATE_REGIONS[0]);\n\n"
    "}\n"
)
message(STATUS
    "Doom session state: ${region_count} regions, ${data_size} initialized bytes, ${bss_size} zero-initialized bytes."
)
